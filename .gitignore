# 依赖
node_modules/

# 渲染产物（锚定在源目录根部；真实产物都在 <源目录>/.foldercast/ 下，已被下一条覆盖）
/out/
*.mp4
*.webm
*.srt
*.vtt

# TTS 产物
public/audio/
/audio/
durations.json

# 素材缓存与工作根（可重算，不必入库）
# 注意：必须锚定根目录 —— 写成 `assets/` 会把 products 代码目录
# packages/plugin/scripts/assets/ 一起忽略掉（踩过一次）
/assets/
.foldercast/

# 插件包内随分发的 schema：由 `pnpm --filter dsh-foldercast prepack` 从
# docs/specs/ 复制生成。契约只有一份，这份是构建产物。
/packages/plugin/schemas/

# 插件发布版（发布前由 tsc 从 src/ 与 scripts/ 编译）。Node 不允许在
# node_modules 里剥离 TypeScript 类型，所以分发的必须是 JS。
/packages/plugin/lib/

# 画面基线（renderer/tests/golden.test.ts 首跑生成）：机器与字体相关，跨机器不可比，不入库
packages/plugin/scripts/renderer/tests/golden.local.json

# 密钥 —— 绝不能提交
.*_api_key
.*_key
credentials.json
.env
.env.*

# 系统
.DS_Store
Thumbs.db

# 测试夹具：里面有故意命中密钥判据的**文件名**、被排除的目录、
# 以及故意写坏的链接，用来验证判据本身。内容都是占位文本，没有任何真凭据。
!packages/plugin/scripts/**/tests/fixtures/**

# 夹具里跑出来的工作根仍然是产物（上面那条 `!` 会把它们重新放进来）：
# 跑一次 analyze/assets 就会在夹具里生成 .foldercast/，不该入库。
packages/plugin/scripts/**/tests/fixtures/**/.foldercast/

# 其他 agent 插件在本仓库留下的缓存标记（video2code / video-agent-kit 的 plugin_root）
.v2c/
.video_agent/
