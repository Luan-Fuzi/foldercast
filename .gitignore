# 依赖
node_modules/

# 渲染产物（锚定在源目录根部；真实产物都在 <源目录>/.foldercast/ 下，已被下一条覆盖）
/out/
*.mp4
*.webm
*.srt
*.vtt

# TTS 产物
public/audio/
/audio/
durations.json

# 素材缓存与工作根（可重算，不必入库）
# 注意：必须锚定根目录 —— 写成 `assets/` 会把 products 代码目录
# packages/plugin/scripts/assets/ 一起忽略掉（踩过一次）
/assets/
.foldercast/

# 密钥 —— 绝不能提交
.*_api_key
.*_key
credentials.json
.env
.env.*

# 系统
.DS_Store
Thumbs.db

# 测试夹具：里面有故意命中密钥判据的**文件名**、被排除的目录、
# 以及故意写坏的链接，用来验证判据本身。内容都是占位文本，没有任何真凭据。
!packages/plugin/scripts/**/tests/fixtures/**
