{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foldercast.dev/schema/script-2.json",
  "title": "foldercast 讲稿",
  "description": "讲稿（分镜），agent 写的创作产物。它是自足的：画面要画的一切都在里面；引用的文件用相对源目录的路径，必须真实存在。跨字段判据（路径存在、字幕可切）在渲染入口的 check 里查。",
  "type": "object",
  "required": [
    "foldercast",
    "source",
    "scenes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "每种场景除 id / type / narration 之外的必需字段，与 contracts/script.ts 的 SCENE_REQUIRED_FIELDS 一致。",
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "cover"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "tree"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "entries"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "inventory"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "groups"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "file"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "file"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "gallery"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "items"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "clip"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "document"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "outro"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "concept"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "statement"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "compare"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "left",
          "right"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "flow"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "steps"
        ]
      }
    }
  ],
  "$defs": {
    "sceneType": {
      "description": "开放枚举：渲染器遇到不认识的类型跳过并警告，而非崩溃。",
      "enum": [
        "cover",
        "tree",
        "inventory",
        "file",
        "gallery",
        "clip",
        "document",
        "outro",
        "concept",
        "compare",
        "flow"
      ]
    },
    "treeEntry": {
      "type": "object",
      "required": [
        "path",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "相对源目录的子路径（通常是顶层目录）"
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "description": "这个子路径下的文件数，条形图按它画宽度"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "字节数，可选；写了就显示"
        },
        "highlight": {
          "type": "boolean",
          "description": "用强调色画这一行"
        }
      },
      "additionalProperties": false
    },
    "inventoryGroup": {
      "type": "object",
      "required": [
        "label",
        "count"
      ],
      "properties": {
        "label": {
          "type": "string",
          "description": "自由文本标签，如「Markdown 笔记」「Office 汇报」"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type",
        "narration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "场景唯一标识，用于配音产物命名与对齐"
        },
        "type": {
          "$ref": "#/$defs/sceneType"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "narration": {
          "type": "string",
          "description": "配音文本，也是字幕来源。要能切成每块 ≤24 显示宽度（中英混排按宽度折算）的字幕块。"
        },
        "durationSec": {
          "type": [
            "number",
            "null"
          ],
          "description": "手写时长（秒）。配音跑过后以实测为准。"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/treeEntry"
          },
          "description": "tree 场景：目录结构摘要，agent 自己数好写进来"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inventoryGroup"
          },
          "description": "inventory 场景：内容分组盘点"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "inventory 场景的分母。缺省用各组 count 之和。"
        },
        "file": {
          "type": "string",
          "description": "file 场景：相对源目录的路径，必须存在"
        },
        "note": {
          "type": "string",
          "description": "file 场景：一行说明（「TypeScript · 约 140 行」），agent 写"
        },
        "excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "file 场景：摘录的原文行。没有素材图的文件靠它上画面。"
        },
        "excerptStart": {
          "type": "integer",
          "minimum": 1,
          "description": "file 场景：摘录首行在源文件中的 1 基行号。写了画面就带行号槽与来源区间。"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "gallery 场景：一组源文件路径（图片；视频会用它的封面图）"
        },
        "source": {
          "type": "string",
          "description": "clip / document 场景：源文件路径，相对源目录"
        },
        "clipRange": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "clip 场景：片段区间 [起秒, 止秒]，只用来标注，不真的截播"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "document 场景：要翻的页码（1 起）。缺省翻全部。"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "outro 场景：结尾的几行小结"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "concept 场景：大字论断，画面主角是这句话本身"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "concept 场景：论断下的支撑要点"
        },
        "left": {
          "$ref": "#/$defs/compareSide",
          "description": "compare 场景：左栏"
        },
        "right": {
          "$ref": "#/$defs/compareSide",
          "description": "compare 场景：右栏"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/flowStep"
          },
          "description": "flow 场景：步骤条（2–6 步，按顺序画）"
        },
        "beats": {
          "type": "array",
          "description": "画面层节拍（v2）：第 i 拍在第 i 条字幕起始时出现。模型只写内容与入场意图。",
          "items": {
            "$ref": "#/$defs/beat"
          }
        }
      },
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "description": "一组同时出现的画面元素 + 声明式入场意图。",
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "要点组：一到三行，同拍出现。画面信息密度主要靠它。"
        },
        "graphic": {
          "enum": ["proportion"],
          "description": "命名图形，由场景的类型化字段确定性生成。proportion = 占比堆叠条（inventory）。"
        },
        "enter": {
          "enum": ["fade", "reveal", "grow", "slide"],
          "description": "入场意图，缺省 reveal。曲线由渲染器实现。"
        }
      },
      "additionalProperties": false
    },
    "compareSide": {
      "type": "object",
      "description": "compare 场景的一侧：标签 + 几行内容。",
      "required": ["label", "lines"],
      "properties": {
        "label": {
          "type": "string",
          "description": "这一侧的名字（如「edge」「mimo」）"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "这一侧的几行内容"
        }
      },
      "additionalProperties": false
    },
    "flowStep": {
      "type": "object",
      "description": "flow 场景的一步。",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "description": "步骤名（两三个词）"
        },
        "note": {
          "type": "string",
          "description": "一步的补充说明（一行以内）"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "foldercast": {
      "type": "integer",
      "const": 2,
      "description": "格式版本。v2：场景支持 beats 节拍（画面层）。"
    },
    "source": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "被讲解目录的绝对路径"
        },
        "label": {
          "type": "string",
          "description": "展示用名称，默认取目录名"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "description": "整片标题，可选。缺省用目录名。"
    },
    "video": {
      "type": "object",
      "description": "出片规格，全部可选。缺省 1920×1080 @ 30fps。",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "default": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "default": 1080
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "targetDurationSec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "期望时长，软约束。没配音时按比例缩放各场景时长；配过音以实测为准、忽略它。"
        }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "description": "配音配置。provider 由设置页定（edge 默认 / mimo），实际音色以 durations.json 为准。",
      "properties": {
        "voice": {
          "type": "string",
          "description": "音色，provider 各自的叫法（edge 如 zh-CN-XiaoxiaoNeural）。缺省自动挑中文音色。"
        },
        "style": {
          "type": "string",
          "description": "怎么读。mimo 用作风格指令；edge 表达不了。"
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "description": "分镜。引用的文件必须真实存在；渲染入口的 check 会逐条核对。",
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  }
}
