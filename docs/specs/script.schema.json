{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foldercast.dev/schema/script-1.json",
  "title": "foldercast 讲稿",
  "description": "目录解读的讲稿（分镜）。由叙事层或人产出，是创作产物。字段语义见 docs/specs/SPEC-data-format.md 第二节；它引用的解读见 foldercast.schema.json。",
  "type": "object",
  "required": [
    "foldercast",
    "source",
    "scenes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "每种场景除 id / type / narration 之外的必需字段，与 SPEC-data-format.md 的「场景类型清单（MVP）」那张表一致。这里用条件约束表达，是校验器报出的「缺哪个字段」的依据。",
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "cover"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "tree"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "highlight"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "inventory"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "groups"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "file"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "file"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "gallery"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "items"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "clip"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "document"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "source",
          "pages"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "outro"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "title"
        ]
      }
    }
  ],
  "$defs": {
    "kind": {
      "description": "文件内容类别。场景引用文件时用于说明类型。",
      "enum": [
        "code",
        "text",
        "markup",
        "data",
        "office",
        "pdf",
        "image",
        "video",
        "audio",
        "archive",
        "binary",
        "other"
      ]
    },
    "sceneType": {
      "description": "开放枚举：渲染器遇到不认识的类型应跳过并警告，而非崩溃。",
      "enum": [
        "cover",
        "tree",
        "inventory",
        "file",
        "gallery",
        "clip",
        "document",
        "outro"
      ]
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "type",
        "narration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "场景唯一标识，用于配音产物命名与对齐"
        },
        "type": {
          "$ref": "#/$defs/sceneType"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "narration": {
          "type": "string",
          "description": "既是配音文本，也是字幕来源。字幕块由阶段③按标点与字数切分。"
        },
        "durationSec": {
          "type": [
            "number",
            "null"
          ],
          "description": "null 表示由阶段③按实测音频回填"
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "tree 场景：需要强调的子路径"
        },
        "groups": {
          "type": "array",
          "description": "inventory 场景：内容分组盘点",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "count"
            ],
            "properties": {
              "kind": {
                "$ref": "#/$defs/kind"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "file": {
          "type": "string",
          "description": "file 场景：相对 source.root 的路径。必须存在于解读的 manifest 里"
        },
        "asset": {
          "type": "string",
          "description": "file 场景：已生成的素材路径"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "gallery 场景：图片素材路径列表"
        },
        "source": {
          "type": "string",
          "description": "clip/document 场景：源文件路径"
        },
        "poster": {
          "type": "string",
          "description": "clip 场景：封面图"
        },
        "clipRange": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "clip 场景：片段区间 [起秒, 止秒]"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "document 场景：逐页转图后的素材路径"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "foldercast": {
      "type": "integer",
      "const": 1,
      "description": "所引用的解读格式版本。解读与讲稿各自独立版本化。"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "被讲解目录的绝对路径，须与解读一致"
        },
        "label": {
          "type": "string",
          "description": "展示用名称，默认取目录名"
        }
      },
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "description": "整片标题，可选"
    },
    "video": {
      "type": "object",
      "description": "出片规格。与解读里的 video 同形状；讲稿这一份优先。渲染阶段（M7）读它，缺省 1920×1080 / 30fps。",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "default": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "default": 1080
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "targetDurationSec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "期望时长，软约束。null 表示由内容决定。写了就按比例缩放各场景时长，不硬截断文案。"
        },
        "language": {
          "type": "string",
          "default": "zh-CN"
        }
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "description": "配音配置（需求 R6）。provider 与 voice 是 provider 内的字符串，不做跨 provider 统一枚举。实际使用的以 durations.json 为准。",
      "properties": {
        "provider": {
          "type": "string",
          "description": "TTS 供应商标识，如 say / mimo"
        },
        "voice": {
          "type": "string",
          "description": "provider 内的音色标识。say 是系统音色名，MiMo 是「白桦」这样的字符串 ID"
        },
        "style": {
          "type": "string",
          "description": "怎么读：风格指令、语速、情绪。各 provider 自行翻译（MiMo 的 user 消息 / say 的 -r）"
        },
        "format": {
          "type": "string",
          "enum": [
            "wav",
            "mp3"
          ],
          "description": "音频格式。默认 wav"
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "description": "风格：预设名 + token 覆盖。写稿阶段选定，渲染阶段应用（M7）。",
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "description": "预设名，见 styles/ 下的文件名"
        },
        "overrides": {
          "type": "object",
          "description": "覆盖预设里的任意 token。键为点分路径，如 palette.bg。",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "natural": {
          "type": "string"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "description": "分镜。只能引用解读里存在的路径，生成后必须校验，幻觉路径要拦截。",
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  }
}
