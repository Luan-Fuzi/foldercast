{
  "name": "foldercast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "把任意人类可读的目录变成讲解视频。本文件只服务仓库工具；产品代码在 packages/plugin 下（M1 起）。",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "pnpm run check:links && pnpm run check:json && pnpm run check:styles && pnpm run check:examples",
    "check:links": "node scripts/check-links.ts",
    "check:json": "node scripts/check-json.ts",
    "check:styles": "node scripts/check-styles.ts",
    "check:examples": "node scripts/check-examples.ts",
    "analyze": "node packages/plugin/scripts/analyzer/main.ts",
    "assets": "node packages/plugin/scripts/assets/main.ts",
    "validate": "node packages/plugin/scripts/validate/main.ts",
    "html": "node packages/plugin/scripts/html/main.ts",
    "render": "node packages/plugin/scripts/renderer/main.ts",
    "voice": "node packages/plugin/scripts/voice/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter dsh-foldercast typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
