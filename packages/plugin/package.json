{
  "name": "dsh-foldercast",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "把任意人类可读的目录变成讲解视频。已有分析器（scripts/analyzer）、素材阶段（scripts/assets）与契约校验（scripts/validate）；工具注册、Config schema、locale 与 skill 在 M4 补上。",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "analyze": "node scripts/analyzer/main.ts",
    "assets": "node scripts/assets/main.ts",
    "validate": "node scripts/validate/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "officeparser": "^8.1.0",
    "shiki": "^4.5.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/libreoffice-kit": "^0.1.5"
  }
}
