{
  "name": "dsh-foldercast",
  "version": "0.1.0",
  "type": "module",
  "description": "把任意人类可读的目录变成讲解视频：分析、素材、契约校验随包分发。",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "foldercast", "video", "agent"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": "./lib/src/index.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "scripts",
    "!scripts/**/tests",
    "schemas",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "analyze": "node scripts/analyzer/main.ts",
    "assets": "node scripts/assets/main.ts",
    "validate": "node scripts/validate/main.ts",
    "html": "node scripts/html/main.ts",
    "sync-schemas": "node scripts/tools/sync-schemas.ts",
    "prepack": "node scripts/tools/sync-schemas.ts && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "officeparser": "^8.1.0",
    "shiki": "^4.5.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/libreoffice-kit": "^0.1.5"
  }
}
